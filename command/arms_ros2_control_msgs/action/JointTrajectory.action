# Goal
string[] joint_names
arms_ros2_control_msgs/JointWaypoint[] waypoints
# True: timed trajectory; False: constraint mode (DOUBLES only).
bool time_mode
# Seconds, 0 = unspecified. Positive values persist to movej_trajectory_duration.
# Mutually exclusive with nonzero waypoint time_from_start.
float64 movej_trajectory_duration
---
# Result
bool success
string message
float64 planned_duration
float64 actual_duration
---
# Feedback
float64 progress
float64 elapsed_time
float64 remaining_time
